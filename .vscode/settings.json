{
  // These are already specified in .shellcheckrc. However, `source-path` with
  // `SCRIPTDIR` does not seem to work in VS Code.
  "shellcheck.customArgs": ["--source-path=${workspaceFolder}"],

  "[shellscript]": {
    "editor.defaultFormatter": "foxundermoon.shell-format"
  },
  "[bats]": {
    "editor.defaultFormatter": "foxundermoon.shell-format"
  }
}
